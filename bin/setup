#!/usr/bin/env sh
set -eu

cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
    cp docker/env.example .env
fi

if [ ! -f .env.example ]; then
    cp docker/env.example .env.example
fi

docker compose build
docker compose run --rm --no-deps app composer install
docker compose run --rm --no-deps vite npm install
docker compose run --rm app php artisan key:generate --force
docker compose up -d postgres redis mailpit
docker compose run --rm app php artisan migrate --force
docker compose run --rm app php artisan db:seed --force
docker compose run --rm --no-deps app php artisan wayfinder:generate --with-form
docker compose run --rm --no-deps app php artisan storage:link
docker compose up -d

echo "App:      http://localhost:8080"
echo "Mailpit:  http://localhost:8025"
echo "Admin:    admin@example.com (passwordless — use Mailpit)"
