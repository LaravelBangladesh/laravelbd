APP_NAME="Laravel Bangladesh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_PREVIOUS_KEYS=
APP_VERSION=dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel_bangladesh
DB_USERNAME=laravel
DB_PASSWORD=secret
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_DELIVERY_URL=
IMAGE_DRIVER=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@laravelbangladesh.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin

# Optional. Defaults to APP_KEY. Set a dedicated value if you rotate APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
VITE_HMR_HOST=localhost

# Production (compose.prod.yml)
# Copy this file to .env on the server, generate APP_KEY, and set:
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.tld
# APP_KEY=
#
# TLS: Cloudflare proxy on (orange cloud), SSL mode "Full (strict)". nginx
# serves :443 with a Cloudflare Origin Certificate and redirects :80. Point
# ORIGIN_CERT_PATH at the host directory holding origin.pem and origin.key.
# HTTP_PORT=80
# HTTPS_PORT=443
# ORIGIN_CERT_PATH=/etc/ssl/cloudflare
# LOG_LEVEL=error
# DB_PASSWORD=
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=your-domain.tld
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SCHEME=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="hello@your-domain.tld"
# CLOUDFLARE_IMAGES_ACCOUNT_ID=
# CLOUDFLARE_IMAGES_API_TOKEN=
# CLOUDFLARE_IMAGES_DELIVERY_URL=
# IMAGE_DRIVER=cloudflare
# PASSKEYS_USER_HANDLE_SECRET=
