# Production template. Copy to .env on the server, chmod 600, and fill in every
# value marked CHANGE ME. Values not listed here keep the framework defaults,
# which are already correct for production.
#
# The release workflow rewrites APP_IMAGE_TAG and APP_VERSION on deploy and
# leaves everything else alone, so secrets edited here survive a release.

APP_NAME="Laravel Bangladesh"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://laravelbd.com                 # CHANGE ME if the canonical host differs
APP_KEY=                                      # CHANGE ME: php artisan key:generate --show

APP_IMAGE_TAG=1.0.0
APP_VERSION=1.0.0

# Logs go to stderr so Docker collects them and a log shipper can forward them
# off the host. Writing to storage/logs instead would keep them inside the
# container, invisible to the shipper and growing on disk.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=error

# TLS terminates at Cloudflare and is re-encrypted to this origin with a
# Cloudflare Origin Certificate. Cloudflare SSL mode must be "Full (strict)".
HTTP_PORT=80
HTTPS_PORT=443
ORIGIN_CERT_PATH=/etc/ssl/cloudflare

# Compose creates the database with these values on first boot. Changing them
# afterwards does not rename an existing database.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravelbd
DB_USERNAME=laravelbd
DB_PASSWORD=                                  # CHANGE ME: openssl rand -base64 32

# Redis backs sessions, cache, and the queue.
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.laravelbd.com                 # CHANGE ME if the domain differs

# Sign-in is passwordless, so mail delivery is required for anyone to log in.
MAIL_MAILER=smtp
MAIL_HOST=                                    # CHANGE ME
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=                                # CHANGE ME
MAIL_PASSWORD=                                # CHANGE ME
MAIL_FROM_ADDRESS="hello@laravelbd.com"       # CHANGE ME if the sender differs
MAIL_FROM_NAME="${APP_NAME}"

# Uploads go to a public Cloudflare R2 bucket served straight from R2_URL.
# Set IMAGE_DRIVER=local to keep uploads on the app_storage volume instead, or
# =cloudflare to use Cloudflare Images (a paid add-on) with the keys below it.
IMAGE_DRIVER=r2
R2_ACCESS_KEY_ID=                             # CHANGE ME
R2_SECRET_ACCESS_KEY=                         # CHANGE ME
R2_BUCKET=                                    # CHANGE ME
R2_ENDPOINT=                                  # CHANGE ME: https://<account-id>.r2.cloudflarestorage.com
R2_URL=                                       # CHANGE ME: public bucket URL, e.g. https://cdn.laravelbd.com

# CLOUDFLARE_IMAGES_ACCOUNT_ID=
# CLOUDFLARE_IMAGES_API_TOKEN=
# CLOUDFLARE_IMAGES_DELIVERY_URL=

PASSKEYS_USER_HANDLE_SECRET=                  # CHANGE ME: openssl rand -base64 32

ADMIN_NAME="Site Admin"                       # CHANGE ME
ADMIN_EMAIL=                                  # CHANGE ME: seeded admin account
